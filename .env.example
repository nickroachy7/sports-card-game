# ─────────────────────────────────────────────────────────────────────────────
# Draft Deck — environment template
#
# Copy to .env.local and fill in real values. Variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.
# src/lib/env.ts validates this file at boot — missing required vars throw.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────

# Public URL of the deployed app. Used for OAuth redirects, SEO, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase (required in all environments) ──────────────────────────────────

# Project URL — copy from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=""

# Anon (publishable) key — safe to expose to the browser. Scoped by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service-role key — bypasses RLS. Server only. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# JWT signing secret — used to verify Supabase-issued JWTs server-side.
SUPABASE_JWT_SECRET=""

# Direct Postgres connection string for Drizzle migrations + server queries.
# Local dev: postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=""

# ── BallDontLie (required for roster / stats ingest) ─────────────────────────

# GOAT-tier API key. Dev + prod get separate keys.
BDL_API_KEY=""

# HMAC-SHA256 secret used to verify webhook payload signatures.
BDL_WEBHOOK_SECRET=""

# ── Upstash Redis (rate limit + idempotency) ─────────────────────────────────

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Sentry (error tracking) ──────────────────────────────────────────────────

# Public DSN — shipped to the browser.
NEXT_PUBLIC_SENTRY_DSN=""

# Server-side DSN (may equal the public DSN — Sentry allows reuse).
SENTRY_DSN=""

# Auth token used by withSentryConfig to upload source maps during build.
SENTRY_AUTH_TOKEN=""

# Org slug from the Sentry dashboard URL.
SENTRY_ORG=""

# Project slug from the Sentry dashboard URL.
SENTRY_PROJECT=""

# Optional environment tag (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=""

# ── PostHog (product analytics + feature flags) ──────────────────────────────

# Project API key — public. Used by posthog-js in the browser.
NEXT_PUBLIC_POSTHOG_KEY=""

# Ingest host — US cloud is the default.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Optional server-only key if you want a distinct key for posthog-node.
# Defaults to NEXT_PUBLIC_POSTHOG_KEY when unset.
POSTHOG_API_KEY=""

# ── Cron / webhook auth ──────────────────────────────────────────────────────

# Shared secret that Vercel Cron passes as `Authorization: Bearer ${CRON_SECRET}`.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=""
